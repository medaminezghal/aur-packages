# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=pymunk
pkgname=python-$_name
pkgver=7.4.0
pkgrel=1
pkgdesc='Pymunk is a easy-to-use pythonic 2D physics library.'
arch=('x86_64' 'aarch64')
url='https://github.com/viblo/pymunk'
license=('MIT')
depends=('python'
         'python-cffi'
         'glibc')
makedepends=('python-setuptools'
             'python-wheel'
             'python-cffi'
             'python-build'
             'python-installer'
             'cmake'
             'gcc')
checkdepends=('python-pyglet'
              'python-pygame'
              'python-pillow'
              'python-matplotlib'
              'python-numpy')
optdepends=('python-pyglet'
            'python-pygame'
            'python-matplotlib')
_munk2d_commit=47e051689dcd747ad0cc329669d0768767279101
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
        "Munk2D-$_munk2d_commit.tar.gz::https://github.com/viblo/Munk2D/archive/$_munk2d_commit.tar.gz")
sha256sums=('969a62f8517739208fe42eb31561260535be3735884295b483ed91a14546bd81'
            'f295b8877125d9c47dbe2e2058e0171dcc569ecdbb4616cb8e4782e212cf6d29')

prepare(){
  cd "$_name-$pkgver"
  rm -rf Munk2D
  mv "$srcdir"/Munk2D-$_munk2d_commit Munk2D
  # Use the cffi version shipped by Arch
  sed -i '/^requires = \[/,/\]/s/"cffi *[<>=!~][^;"]*/"cffi/' pyproject.toml
}

build(){
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check(){
  cd "$_name-$pkgver"
  local python_version=$(python -c 'import sys; print("".join(map(str, sys.version_info[:2])))')
  cd "build/lib.linux-$CARCH-cpython-$python_version"
  python -m pymunk.tests
}

package(){
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
