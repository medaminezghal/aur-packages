_name=tavily
pkgname=python-$_name
pkgver=0.8.1
pkgrel=1
pkgdesc="Python wrapper for the Tavily API."
arch=('any')
url="https://github.com/tavily-ai/tavily-python"
license=('MIT')
depends=('python' 'python-requests' 'python-tiktoken' 'python-httpx')
makedepends=('python-setuptools' 'python-build' 'python-installer' 'python-wheel')
checkdepends=('python-pytest')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/${_name}-python/${_name}_python-${pkgver}.tar.gz")
sha256sums=('f00d1ecfe9a7ad82a7d6b84427faefe7448e9f16a8115ece3f5fbadc35752c4b')

build() {
  cd "$srcdir"/${_name}_python-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$srcdir"/${_name}_python-$pkgver
  PYTHONPATH=$PWD pytest "${pytest_options[@]}" tests
}

package() {
 cd "$srcdir"/${_name}_python-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
