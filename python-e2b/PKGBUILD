    --deselect tests/sync/sandbox_sync/test_network.py::test_https_ports
    --deselect tests/sync/sandbox_sync/test_network.py::test_mask_request_host
    --deselect tests/sync/sandbox_sync/test_network.py::test_update_network_applies_restrictions
