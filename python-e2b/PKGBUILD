# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=e2b
pkgname=python-$_name
pkgver=2.31.0
pkgrel=1
pkgdesc='E2B SDK that give agents cloud environments.'
arch=('any')
url='https://github.com/e2b-dev/E2B'
license=('MIT')
depends=('python'
         'python-dateutil'
         'python-wcmatch'
         'python-protobuf'
         'python-httpcore'
         'python-httpx'
         'python-h2'
         'python-attrs'
         'python-packaging'
         'python-typing_extensions'
         'python-dockerfile-parse'
         'python-rich')
makedepends=('python-uv-build'
             'python-build'
             'python-installer'
             'python-wheel')
checkdepends=('python-pytest'
              'python-pytest-asyncio'
              'python-pytest-timeout')
source=("$_name::git+$url.git#commit=0feb92693701b9758c7909ca64f2dc92a82d89f5")
sha256sums=('61bb326c02dd140543e718fd9430ff3f0a3ae3ee91260b0b4f69e88f6762ef01')

prepare() {
  cd "$srcdir"/$_name/packages/python-sdk
  # Use the uv_build version shipped by Arch
  sed -i 's/uv_build>=0.10.0,<0.11.0/uv_build/' pyproject.toml
}

build() {
  cd "$srcdir"/$_name/packages/python-sdk
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$srcdir"/$_name/packages/python-sdk
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" tests
}

package() {
  cd "$srcdir"/$_name/packages/python-sdk
  python -m installer --destdir="$pkgdir" dist/*.whl
}
