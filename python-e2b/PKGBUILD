    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_apt_install
    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_bun_install
    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_copy
    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_copyItems
    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_dev_container_prebuild
    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_from_aws_registry
    --deselect tests/sync/template_sync/test_stacktrace.py::test_traces_on_from_dockerfile
