# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=aiocarbon
pkgname=python-$_name
pkgver=0.17.0
pkgrel=1
pkgdesc='Asynchronous client for carbon.'
arch=('any')
url='https://github.com/mosquito/aiocarbon'
license=('Apache-2.0')
depends=('python')
makedepends=('python-hatchling'
             'python-build'
             'python-installer')
checkdepends=('python-pytest'
              'python-pytest-asyncio')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('4269f637ca9d9834efb33deaa89658694e5452bb98fe14922afe191a8c7bca74')

prepare() {
  cd "$_name-$pkgver"
  # Upstream sets the version only when publishing, the tag still holds the previous one
  sed -i "s/^version = .*/version = \"$pkgver\"/" pyproject.toml
}

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    --override-ini="addopts="
  )
  cd "$_name-$pkgver"
  PYTHONPATH=$PWD pytest "${pytest_options[@]}"
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
