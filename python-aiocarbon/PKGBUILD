# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=aiocarbon
pkgname=python-$_name
pkgver=0.17.0
pkgrel=1
pkgdesc='Asynchronous client for carbon.'
arch=('any')
url='https://github.com/mosquito/aiocarbon'
license=('Apache-2.0')
depends=('python'
         'python-immutables')
makedepends=('python-setuptools'
             'python-build'
             'python-installer')
checkdepends=('python-pytest-asyncio'
              'python-pytest')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
        "python310-loop-argument.patch")
sha256sums=('4269f637ca9d9834efb33deaa89658694e5452bb98fe14922afe191a8c7bca74'
            '8ecf8a5c8cfafbc96a40087776d4603b0597c5b4e0f27cb6c175526caea57833')

prepare() {
  cd "$_name-$pkgver"
  # Drop the loop arguments removed from asyncio in Python 3.10 and use the running loop in the tests
  patch -Np1 -i ../python310-loop-argument.patch
}

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$_name-$pkgver"
  PYTHONPATH=$PWD pytest "${pytest_options[@]}" tests
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
