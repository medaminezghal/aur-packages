prepare(){
  cp -f "$srcdir"/silero_vad.onnx "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver/$_name1/$_name1-silero/${_name1//-//}/silero/resources/silero_vad.onnx
  cp -f "$srcdir"/long.mp3 "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver/tests/long.mp3
  cp -f "$srcdir"/change-sophie.opus "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver/tests/change-sophie.opus
  cp -f "$srcdir"/change-sophie.wav "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver/tests/change-sophie.wav
}

build() {
  cd "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver/$_name0
  python -m build --wheel --no-isolation
  for _plugin in "${_plugins[@]}"; do
    cd "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver/$_name1/$_name1-$_plugin
    python -m build --wheel --no-isolation
  done
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$srcdir"/${_name0//livekit-/}-$_name0-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer $_name0/dist/*.whl
  for _plugin in "${_plugins[@]}"; do
    test-env/bin/python -m installer $_name1/$_name1-$_plugin/dist/*.whl
  done
  test-env/bin/python -m pytest "${pytest_options[@]}" tests $_name1/$_name1-aws/tests $_name1/$_name1-hamming/tests $_name1/$_name1-sarvam/tests
}

