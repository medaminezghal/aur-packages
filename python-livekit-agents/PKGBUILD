livekit-plugins(){
  for ((i=0; i<${#_plugins[@]}; i++)); do
    local _varname="${_plugins[i]//-/_}"
    declare -n _all_deps="$_varname"

    local _deps=()
    local _optdeps=()
    for dep in "${_all_deps[@]}"; do
      [[ "$dep" == *:* ]] && _optdeps+="${dep@Q} " || _deps+="${dep@Q} "
    done
    unset -n _all_deps

    eval "package_python-$_name1-${_plugins[i]}() {
            pkgdesc=\"${_plugins_pkgdesc[i]}\"
            url=\"$_repo/tree/main/$_name1/$_name1-${_plugins[i]}\"
            depends=($_deps)
            ${_optdeps_str:+optdepends=($_optdeps)}
            cd \"\$srcdir\"/${_name0//livekit-/}-$_name0-$pkgver/$_name1/$_name1-${_plugins[i]}
            python -m installer --destdir=\"\$pkgdir\" dist/*.whl
          }"
  done
}

