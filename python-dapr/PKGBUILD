# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=dapr
pkgname=python-$_name
pkgver=1.19.0
pkgrel=1
pkgdesc='The official release of Dapr Python SDK.'
arch=('any')
url='https://github.com/dapr/python-sdk'
license=('Apache-2.0')
depends=('python'
         'python-protobuf'
         'python-grpcio'
         'python-grpcio-status'
         'python-aiohttp'
         'python-dateutil'
         'python-typing_extensions')
makedepends=('python-hatchling'
             'python-build'
             'python-installer')
checkdepends=('python-opentelemetry-sdk'
              'python-httpx'
              'python-cryptography'
              'python-redis'
              'python-flask'
              'python-pytest'
              'python-pytest-asyncio'
              'python-pydantic'
              'python-fastapi'
              'python-cloudevents'
              'python-langgraph'
              'strands-agents'
              'python-ulid'
              'python-msgpack'
              'python-openai'
              'python-langchain-core'
              'python-boto3'
              'python-azure-storage-blob'
              'python-azure-identity'
              'python-psycopg'
              'python-pinecone'
              'python-azure-search-documents')
optdepends=('uvicorn: fastapi'
            'python-langchain: langgraph'

            'python-unstructured: rag-unstructured'
            'python-docx: rag-unstructured'
            'python-markdown: rag-unstructured'
            'python-google-cloud-vision: rag-unstructured'
            'python-pdf2image: rag-unstructured'
            'python-pdfminer: rag-unstructured'
            'python-pi-heif: rag-unstructured'
            'python-pikepdf: rag-unstructured'
            'python-pypdf: rag-unstructured'
            'python-unstructured-inference: rag-unstructured'
            'python-unstructured-pytesseract: rag-unstructured')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fc400549c9cd049829fb4dced489f6fc34ee0a9285795f9bebe9df28e5f5e5d3')

build() {
  cd "python-sdk-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "python-sdk-$pkgver"
  local pytest_options=(
    -vv
    --disable-warnings
    --import-mode=importlib
    -m 'not e2e'
    --ignore=tests/integration
    --ignore=tests/examples
  )
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" tests
}

package() {
  cd "python-sdk-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
