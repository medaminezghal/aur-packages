prepare() {
  cd "$_name0-$pkgver"
  # Remove the devtools import: python-devtools is not a checkdepends and test_examples.py is skipped without pydantic_ai_examples
  sed -i '/^from devtools import debug$/d' tests/test_examples.py
  # Map the Qwen VL models to ovhcloud instead of nebius in the HF provider fixture, as huggingface-hub >= 1.25 dropped the nebius provider
  sed -i "s/('nebius', 'Qwen/('ovhcloud', 'Qwen/" tests/conftest.py
  # Allow huggingface-hub's one-time package version lookup (importlib.metadata) in the event loop, as huggingface-hub 2 does it while building request headers
  sed -i "/('os.getcwd', 'logfire\/_internal\/stack_info.py', 'is_user_code'),/a\    ('os.stat', 'huggingface_hub\/utils\/_runtime.py', '_get_version'),\n    ('io.TextIOWrapper.read', 'huggingface_hub\/utils\/_runtime.py', '_get_version')," tests/conftest.py
  # Replay the nebius image tests through ovhcloud (same plain conversational task), with ovhcloud's genai-prices cost
  sed -i "s/provider_name='nebius', api_key=huggingface_api_key/provider_name='ovhcloud', api_key=huggingface_api_key/;s|router.huggingface.co/nebius'|router.huggingface.co/ovhcloud'|;s/cost=Decimal('0.00008750')/cost=Decimal('0.00029896')/" tests/models/test_huggingface.py
  # Point the two image cassettes at the ovhcloud route to match
  sed -i 's|router.huggingface.co/nebius/|router.huggingface.co/ovhcloud/|' tests/models/cassettes/test_huggingface/test_image_url_input.yaml tests/models/cassettes/test_huggingface/test_image_as_binary_content_input.yaml
  # Raise an httpx2 timeout in the mock transport, as huggingface-hub 2 only converts httpx2.TimeoutException to InferenceTimeoutError
  sed -i "s/^import httpx$/import httpx\nimport httpx2/;s/^    raise TimeoutError$/    raise httpx2.TimeoutException('timed out')/" tests/models/test_huggingface.py
  # Port the stdio test MCP server to mcp 2 (FastMCP was renamed MCPServer and the low-level handlers are registered with add_request_handler)
  patch -Np1 -i ../mcp-v2-test-server.patch
  # Allow pydantic-ai's mcp version lookup (importlib.metadata) in the event loop, as only the mcp 2 code path calls it during a run
  sed -i "/('os.getcwd', 'logfire\/_internal\/stack_info.py', 'is_user_code'),/a\    ('os.stat', 'pydantic_ai\/_mcp_compat.py', 'is_mcp_sdk_v2'),\n    ('os.listdir', 'pydantic_ai\/_mcp_compat.py', 'is_mcp_sdk_v2'),\n    ('io.TextIOWrapper.read', 'pydantic_ai\/_mcp_compat.py', 'is_mcp_sdk_v2'),\n    ('io.BufferedReader.read', 'pydantic_ai\/_mcp_compat.py', 'is_mcp_sdk_v2')," tests/conftest.py
  # Count the mcp 2 handshake (server/discover replaced initialize) in the durable session tests
  sed -i "s/snapshot({'initialize': /snapshot({'server\/discover': /" tests/durable_exec/test_durable_operation.py
  # Send tools/list_changed on the request's stream, as the 2026-07-28 MCP protocol drops notifications not tied to a request
  sed -i "s/^        await ctx.session.send_tool_list_changed()$/        from mcp.types import ToolListChangedNotification\n\n        await ctx.send_notification(ToolListChangedNotification())/" tests/test_tool_population_diff.py
}

build() {
  cd "$_name0-$pkgver"
  export UV_DYNAMIC_VERSIONING_BYPASS=$pkgver
  python -m build --wheel --no-isolation ${_name0//-ai/_}$_name4
  python -m build --wheel --no-isolation ${_name0//-/_}_$_name3
  python -m build --wheel --no-isolation ${_name0//-ai/_}$_name2
  python -m build --wheel --no-isolation
  python -m build --wheel --no-isolation $_name1
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    -p 'no:benchmark'
    -n auto
  )
  cd "$_name0-$pkgver"
  python -m venv --system-site-packages test-env
  ln -sf /usr/bin/ruff test-env/bin/ruff
  ln -sf /usr/bin/pytest test-env/bin/pytest
  test-env/bin/python -m installer ${_name0//-ai/_}$_name4/dist/*.whl
  test-env/bin/python -m installer ${_name0//-/_}_$_name3/dist/*.whl
  rm -rf test-env/bin/pai
  test-env/bin/python -m installer ${_name0//-ai/_}$_name2/dist/*.whl
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m installer $_name1/dist/*.whl
  PATH="$srcdir"/$_name0-$pkgver/test-env/bin:$PATH test-env/bin/python -m pytest "${pytest_options[@]}" tests
}

package_python-pydantic-graph() {
  pkgdesc='Graph and state machine library.'
  depends+=('python-anyio'
            'python-logfire-api'
            'python-pydantic'
            'python-typing-inspection')
  url="$_repo/tree/main/${_name0//-ai/_}$_name4"
  cd "$_name0-$pkgver"
  python -m installer --destdir="$pkgdir" ${_name0//-ai/_}$_name4/dist/*.whl
  install -Dm644 ${_name0//-ai/_}$_name4/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

