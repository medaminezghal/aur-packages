# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=GKlib
pkgname=${_name,,}
pkgver=5.1.1
pkgrel=6
pkgdesc="A library of various helper routines and frameworks used by many of the lab's software"
arch=('x86_64')
url="https://github.com/KarypisLab/$_name"
license=('Apache-2.0')
depends=('glibc'
         'libgcc'
         'libgomp')
makedepends=('cmake'
             'git')
source=("$_name::git+$url.git#tag=METIS-v$pkgver-DistDGL-0.5")
sha256sums=('42235a855d6f37688840864f22d3a3010d5aee7c3dbb6f349e93af565bda7c4b')

prepare() {
  cd "$srcdir"/$_name
  # https://github.com/KarypisLab/METIS/issues/54
  git cherry-pick -n 33b8c8bb8dada74b824badff961532f11d0d5e1c
  git cherry-pick -n 1403a04bc40a306d09adfccced7d903d69de040a
  # Increase the minimum CMake version
  git cherry-pick -n aadab159a00028e47fb5725e05b5eb7732bb6ee2
  # Fix heap buffer overflow in regex backreference substitution
  git cherry-pick -n e2856c2f595b153ca1ce9258c5301dbabc4f39f5
  # Add the VALGRIND option (baseline -march=x86-64 -mtune=generic)
  git cherry-pick -n 0c233a174a36500d32c9e98a7cfc47a2c61a5196
  git cherry-pick -n a7f8172703cf6e999dd0710eb279bba513da4fec
}

build() {
  cd "$srcdir"/$_name
  cmake -S . -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_SHARED_LIBS=ON \
    -DOPENMP=ON \
    -DVALGRIND=ON \
    -Wno-dev
  cmake --build build
}

package() {
  cd "$srcdir"/$_name
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname
}
