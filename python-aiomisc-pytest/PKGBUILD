# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=aiomisc-pytest
pkgname=python-$_name
pkgver=2.0.0
pkgrel=1
pkgdesc='pytest integration for aiomisc.'
arch=('any')
url='https://github.com/aiokitchen/aiomisc-pytest'
license=('MIT')
depends=('python'
         'python-pytest'
         'python-aiomisc')
makedepends=('python-hatchling'
             'python-build'
             'python-installer')
optdepends=('python-uvloop: uvloop')
_commit=b6f974d9ce1dc892b6c33d6e5b04a36f092b9c57
source=("$_name-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('e0b977633a6c80cd476f0767379a974af2fec0db66bea37c2ffc9bcfb31326dc')

build() {
  cd "$_name-$_commit"
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    -p aiomisc_pytest
  )
  cd "$_name-$_commit"
  PYTHONPATH=$PWD pytest "${pytest_options[@]}" tests
}

package() {
  cd "$_name-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
