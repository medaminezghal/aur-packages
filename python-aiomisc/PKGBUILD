_name=aiomisc
pkgname=python-$_name
pkgver=18.0.35
pkgrel=1
pkgdesc='Miscellaneous utils for asyncio.'
arch=('any')
url='https://github.com/aiokitchen/aiomisc'
license=('MIT')
depends=('python'
         'python-aiothreads'
         'python-colorlog'
         'python-logging-journald')
makedepends=('python-setuptools'
             'python-setuptools-scm'
             'python-build'
             'python-installer'
             'python-hatchling')
checkdepends=('python-aiocarbon'
              'python-aiohttp'
              'python-aiohttp-asgi'
              'python-asgiref'
              'python-croniter'
              'python-dnslib'
              'python-fastapi'
              'python-grpcio'
              'python-grpcio-reflection'
              'python-grpcio-tools'
              'python-pytest'
              'python-raven'
              'python-rich'
              'python-setproctitle'
              'uvicorn'
              'python-uvloop')
optdepends=('python-aiohttp: aiohttp'

            'python-aiohttp-asgi: asgi'

            'python-aiocarbon: carbon'

            'python-croniter: cron'

            'python-dnslib: dns'

            'python-grpcio: grpc'
            'python-grpcio-tools: grpc'
            'python-grpcio-reflection: grpc'

            'python-aiohttp: raven'
            'python-raven: raven'

            'python-rich: rich'

            'uvicorn: uvicorn'
            'python-asgiref: uvicorn'

            'python-uvloop: uvloop')
_commit=fb47e0fc3290040391ab4c9699988c3456d01921
_aiomisc_pytest_commit=b6f974d9ce1dc892b6c33d6e5b04a36f092b9c57
source=("$_name-$pkgver.tar.gz::$url/archive/$_commit.tar.gz"
        "aiomisc-pytest-$_aiomisc_pytest_commit.tar.gz::https://github.com/aiokitchen/aiomisc-pytest/archive/$_aiomisc_pytest_commit.tar.gz")
sha256sums=('758ccc56115a83405999148881342067016f8fbca96462a639738e6ba40f0ce9'
            'e0b977633a6c80cd476f0767379a974af2fec0db66bea37c2ffc9bcfb31326dc')

prepare() {
  cd "$_name-$_commit"
  # Replace python-async-timeout with asyncio.timeout from the standard library
  sed -i 's/^from async_timeout import timeout$/from asyncio import timeout/' tests/test_thread_pool.py
}

build() {
  cd "$_name-$_commit"
  export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
  python -m build --wheel --no-isolation
  cd "$srcdir"/aiomisc-pytest-$_aiomisc_pytest_commit
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    --doctest-modules
    --aiomisc-test-timeout=120
  )
  cd "$_name-$_commit"
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m installer "$srcdir"/aiomisc-pytest-$_aiomisc_pytest_commit/dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" tests
}

package() {
  cd "$_name-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
