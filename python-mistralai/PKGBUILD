_name=mistralai
pkgname=python-$_name
pkgver=3.1.0
pkgrel=1
pkgdesc="Python Client SDK for the Mistral AI API."
arch=('any')
url="https://github.com/mistralai/client-python"
license=('MIT')
depends=('python'
         'python-eval-type-backport'
         'python-httpx2'
         'python-jsonpath-python'
         'python-opentelemetry-api'
         'python-opentelemetry-semantic-conventions'
         'python-pydantic'
         'python-dateutil'
         'python-typing-inspection')
makedepends=('python-hatchling' 'python-build' 'python-installer' 'python-wheel')
checkdepends=('python-pyyaml'
              'python-msgpack'
              'python-opentelemetry-instrumentation-httpx'
              'python-opentelemetry-sdk'
              'python-opentelemetry-exporter-otlp-proto-http'
              'python-pytest'
              'python-pytest-asyncio'
              'python-mcp'
              'python-griffe'
              'python-authlib'
              'python-websockets'
              'python-zstandard'
              'python-google-auth')
optdepends=('python-authlib: agents'
            'python-griffe: agents'
            'python-mcp: agents'

            'python-google-auth: gcp'
            'python-requests: gcp'

            'python-mcp: mcp'

            'python-websockets: realtime'

            'python-opentelemetry-exporter-otlp-proto-http: telemetry'
            'python-opentelemetry-sdk: telemetry'

            'python-msgpack: workflow-payload-compression'
            'python-zstandard: workflow-payload-compression'

            'python-cryptography: workflow-payload-encryption'

            'python-aioboto3: workflow-payload-offloading'
            'python-azure-identity: workflow-payload-offloading'
            'python-azure-storage-blob: workflow-payload-offloading'
            'python-aiohttp: workflow-payload-offloading'
            'python-gcloud-aio-storage: workflow-payload-offloading'

            'python-azure-identity: workflow-payload-offloading-azure'
            'python-azure-storage-blob: workflow-payload-offloading-azure'
            'python-aiohttp: workflow-payload-offloading-azure'

            'python-gcloud-aio-storage: workflow-payload-offloading-gcs'

            'python-aioboto3: workflow-payload-offloading-s3')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('23afd443ade2a81f2effb0d79143d7ee7c814ca6562e1c516dd57b58d3ad5495')

build() {
  cd "$srcdir"/client-python-$pkgver
  python -m build --wheel --no-isolation
}

check(){
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$srcdir"/client-python-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" tests
}

package() {
  cd "$srcdir"/client-python-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}

