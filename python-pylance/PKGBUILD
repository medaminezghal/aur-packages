# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=pylance
pkgname=python-$_name
pkgver=14.0.3
pkgrel=1
pkgdesc='Python bindings for the Lance columnar data format.'
arch=('x86_64' 'aarch64')
_repo='https://github.com/lance-format/lance'
url="$_repo/tree/main/python"
license=('Apache-2.0')
depends=('python'
         'python-pyarrow'
         'python-numpy'
         'python-lance-namespace'
         'libgcc'
         'glibc')
makedepends=('python-maturin'
             'python-build'
             'python-installer'
             'protobuf')
checkdepends=('python-datasets'
              'python-duckdb'
              'python-ml-dtypes'
              'python-pillow'
              'python-pandas'
              'python-polars'
              'python-psutil'
              'python-pytest'
              'python-pytest-xdist'
              'python-tqdm'
              'python-pytorch')
optdepends=('python-opentelemetry-api: otel'
            'python-opentelemetry-sdk: otel'

            'python-geoarrow-rust-core: geo'
            'python-geoarrow-rust-io: geo')
source=("$_name-$pkgver.tar.gz::$_repo/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b04f172dd509f7f266d0adc3725874a5e8baf1a504440df5eb0da33f4bc11618')

prepare() {
  cd "lance-$pkgver/python"
  # Use the maturin version shipped by Arch
  sed -i '/^requires = /s/"maturin[<>=!~][^"]*"/"maturin"/' pyproject.toml
}

build() {
  cd "lance-$pkgver/python"
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    -s
    --durations=30
    -n auto
    --dist loadgroup
  )
  cd "lance-$pkgver/python"
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" tests
}

package() {
  cd "lance-$pkgver/python"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
