# Maintainer: Mohamed Amine Zghal (medaminezghal) <medaminezghal at outlook dot com>

_name=typesafe-sdk
pkgname=python-$_name
pkgver=0.7.5
pkgrel=1
pkgdesc='Python SDK for TypeSafe AI API.'
arch=('any')
url='https://github.com/typesafe-ai/typesafe-sdk-python'
license=('MIT')
depends=('python'
         'python-anyio'
         'python-httpx2'
         'python-packaging'
         'python-pydantic'
         'python-pydantic-core'
         'python-tenacity'
         'python-truststore'
         'python-typing_extensions')
makedepends=('python-uv-build'
             'python-build'
             'python-installer')
checkdepends=('python-pillow'
              'python-pytest'
              'python-pytest-asyncio'
              'python-sybil'
              'python-syrupy')
optdepends=('python-httpx2: http2'
            'python-h2: http2'

            'python-pillow: pil')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2b6b79524aa40dbd2a0d79d68cd15186df38f1093b7390a1550c9a75a5db66d7')

build() {
  cd "$_name-python-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$_name-python-$pkgver"
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" tests
}

package() {
  cd "$_name-python-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
