_name=GKlib
pkgname=${_name,,}
pkgver=0.0.1
pkgrel=1
epoch=1
pkgdesc="A library of various helper routines and frameworks used by many of the lab's software"
arch=('x86_64')
url="https://github.com/KarypisLab/$_name"
license=('Apache-2.0')
depends=('glibc'
         'libgcc'
         'libgomp')
makedepends=('cmake'
             'git')
source=("$_name::git+$url.git#tag=v$pkgver")
sha256sums=('9978fc259424638b35bbe5b2e6d90650f32fb0a660a763a1876aae01556c3283')

build() {
  cd "$srcdir"/$_name
  cmake -S . -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DSHARED=ON \
    -DOPENMP=ON \
    -Wno-dev
  cmake --build build
}

package() {
  cd "$srcdir"/$_name
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname
}
