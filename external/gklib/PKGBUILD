_name=GKlib
pkgname=${_name,,}
pkgver=0.0.1
pkgrel=2
epoch=1
pkgdesc="A library of various helper routines and frameworks used by many of the lab's software"
arch=('x86_64')
url="https://github.com/KarypisLab/$_name"
license=('Apache-2.0 AND LGPL-2.1-or-later')
depends=('glibc'
         'libgcc'
         'libgomp')
makedepends=('cmake')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9ab4e0b4c3e06fde1de5b83991b9bcd9a3f424e8fe435e46020045fdc8a8e2b9')

build() {
  cd "$_name-$pkgver"
  cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -DSHARED=ON -DOPENMP=ON -Wno-dev
  cmake --build build
}

package() {
  cd "$_name-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
