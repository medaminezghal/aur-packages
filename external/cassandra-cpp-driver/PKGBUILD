pkgname=cassandra-cpp-driver
pkgver=2.17.1
pkgrel=4
pkgdesc="DataStax C/C++ Driver for Apache Cassandra"
arch=('x86_64' 'aarch64')
url="https://github.com/apache/$pkgname"
license=('Apache-2.0')
depends=('glibc'
         'libgcc'
         'libstdc++'
         'libuv'
         'openssl'
         'krb5'
         'zlib')
makedepends=('cmake')
checkdepends=('nss_wrapper')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
        'openssl-4.patch'
        'openssl-4-tests.patch')
sha256sums=('e6ab5f5c60a916dd6c0dd9a19a883a4a1ab3d6b4e95cab925a186fecff08344e'
            '47fa717528dd5d482ee9b1c495e3a31d54112179676aaa7006b6b074109c72a4'
            '196e4f86b65ddbf001259808ed216cdb4f905e5a6f466325d720c86661cba20c')

prepare() {
  cd "$pkgname-$pkgver"
  # Constify X509 name/ASN1 string pointers for OpenSSL 4 (upstream commit b01f0dc)
  patch -Np1 -i ../openssl-4.patch
  # Fix the unit tests for OpenSSL 4: build new X509 names instead of editing the const ones, use a valid request version
  patch -Np1 -i ../openssl-4-tests.patch
  # Don't turn warnings into errors (ASN1_STRING_length is deprecated since OpenSSL 4.1)
  sed -i 's/ -Werror")/")/' src/CMakeLists.txt
}

build() {
  cd "$pkgname-$pkgver"
  cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=None -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCASS_BUILD_SHARED=ON -DCASS_BUILD_STATIC=OFF -DCASS_USE_OPENSSL=ON -DCASS_USE_ZLIB=ON -DCASS_USE_KERBEROS=ON -DCASS_USE_TIMERFD=ON -DCASS_USE_STD_ATOMIC=ON -DCASS_BUILD_UNIT_TESTS=ON -Wno-dev
  cmake --build build
}

check() {
  cd "$pkgname-$pkgver"
  printf '127.254.254.254 cpp-driver.hostname. cpp-driver.hostname\n' > build/hosts
  LD_PRELOAD=libnss_wrapper.so NSS_WRAPPER_HOSTS="$PWD/build/hosts" ./build/cassandra-unit-tests
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
