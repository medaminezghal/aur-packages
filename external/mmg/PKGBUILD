pkgname=mmg
pkgver=5.8.0
pkgrel=2
pkgdesc='Anisotropic tetrahedral remesher and moving mesh generator'
arch=('i686' 'x86_64')
url="https://github.com/MmgTools/$pkgname"
license=('LGPL-3.0-or-later')
depends=('glibc'
         'scotch'
         'vtk'
         'pugixml'
         'python-mpi4py')
makedepends=('cmake'
             'netcdf'
             'proj'
             'qt6-base'
             'glew'
             'python'
             'libogg'
             'libtheora'
             'fmt'
             'onetbb')
provides=('mmg3d')
conflicts=('mmg3d')
replaces=('mmg3d')
_ci='https://static.bordeaux.inria.fr/mmg'
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "$_ci/mmg.tgz"
        "$_ci/mmg2d.tgz"
        "$_ci/mmg3d.tgz"
        "$_ci/mmgs.tgz"
        "$_ci/mmg.version"
        "$_ci/mmg2d.version"
        "$_ci/mmg3d.version"
        "$_ci/mmgs.version")
sha256sums=('686eaab84de79c072f3aedf26cd11ced44c84b435d51ce34e016ad203172922f'
            'd4dddb3a6a5a0bb6dcb5a4448aa0353b0fe0af7d775503b9785d32386ca83ca0'
            '9800964f642996bff3b54eb80d92d5062cd1f2fac30cd38590e58338f5ad6736'
            'd97920d92de907f850cf7e8c5c2bb8b3a232a6853b304da9b73afc80213859d7'
            'ca8a719bbf5cfa79ae6969643b8258b6d9fce308e5587117ce6b8c0c84984dab'
            '70f67cbedcd68a755dec43879b0ff7cd9ab2e697d64839be798e8b5764394cf2'
            '3fe4774c63627bdd7402b42c8cf24e228f592438ea121f9ca0b20766791e573e'
            'aaf2b3079724dec0b582cb2c9cf8a32e10cc37193227165c9111e487b4baec5d'
            'eef1e4279861bdd3bd2a7649bfc03cfa14e2c18c7b2a7c12dcbca265b6da93e5')

prepare() {
  cd "$pkgname-$pkgver"
  # Use the test cases from the sources instead of downloading them at configure time
  mkdir -p ci_tests
  ln -sf "$srcdir"/mmg "$srcdir"/mmg2d "$srcdir"/mmg3d "$srcdir"/mmgs ci_tests/
  cp -L "$srcdir"/mmg.version "$srcdir"/mmg2d.version "$srcdir"/mmg3d.version "$srcdir"/mmgs.version ci_tests/
}

build() {
  cd "$pkgname-$pkgver"
  cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -DBUILD_SHARED_LIBS=ON -DLIBMMG_STATIC=OFF -DLIBMMG2D_STATIC=OFF -DLIBMMGS_STATIC=OFF -DLIBMMG3D_STATIC=OFF -DUSE_SCOTCH=ON -DUSE_VTK=ON -DUSE_ELAS=OFF -DMMG_INSTALL_PRIVATE_HEADERS=ON -DBUILD_TESTING=ON -DLONG_TESTS=ON -DCI_CONTEXT=ON -Wno-dev
  cmake --build build
}

check() {
  cd "$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
