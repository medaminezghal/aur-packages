pkgbase=kokkos
pkgname=('kokkos'
         'kokkos-cuda')
pkgver=5.2.2
pkgrel=2
pkgdesc="C++ performance portability programming ecosystem"
arch=('x86_64')
url="https://github.com/$pkgbase/$pkgbase"
license=('Apache-2.0 WITH LLVM-exception')
depends=('bash'
         'glibc'
         'libgcc'
         'libstdc++'
         'hwloc')
makedepends=('cmake'
             'cuda')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('491fe02cb127559dd3c996f6693686f1eab00a53fd5c184e18e663896884175e')

build() {
  cd "$pkgbase-$pkgver"
  cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -DBUILD_SHARED_LIBS=ON -DKokkos_ENABLE_SERIAL=ON -DKokkos_ENABLE_OPENMP=ON -DKokkos_ENABLE_HWLOC=ON -DKokkos_ENABLE_LIBDL=ON -DKokkos_ENABLE_TESTS=ON -Wno-dev
  cmake --build build
  export PATH="/opt/cuda/bin:$PATH"
  cmake -S . -B build-cuda -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -DCMAKE_CXX_COMPILER="$PWD"/bin/nvcc_wrapper -DBUILD_SHARED_LIBS=ON -DKokkos_ENABLE_SERIAL=ON -DKokkos_ENABLE_OPENMP=ON -DKokkos_ENABLE_CUDA=ON -DKokkos_ENABLE_CUDA_CONSTEXPR=ON -DKokkos_ARCH_TURING75=ON -DKokkos_ENABLE_HWLOC=ON -DKokkos_ENABLE_LIBDL=ON -Wno-dev
  cmake --build build-cuda
}

check() {
  cd "$pkgbase-$pkgver"
  ctest --test-dir build --output-on-failure
}

package_kokkos() {
  conflicts=('trilinos')
  cd "$pkgbase-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_kokkos-cuda() {
  pkgdesc+=" (with CUDA)"
  depends+=('cuda')
  provides=("kokkos=$pkgver")
  conflicts=('kokkos'
             'trilinos')
  cd "$pkgbase-$pkgver"
  DESTDIR="$pkgdir" cmake --install build-cuda
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
