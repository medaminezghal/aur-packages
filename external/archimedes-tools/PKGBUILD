pkgbase=archimedes-tools
pkgname=('triangle'
         'showme')
pkgver=1.6
pkgrel=10
pkgdesc="Archimedes is a set of tools, including mesh generators, for performing unstructured finite element simulations"
arch=('i686' 'x86_64')
url="https://www.cs.cmu.edu/~quake/archimedes.html"
license=('LicenseRef-Triangle')
makedepends=('libx11')
source=('http://www.netlib.org/voronoi/triangle.zip'
        'triangle_definitions.patch')
sha256sums=('1766327add038495fa3499e9b7cc642179229750f7201b94f8e1b7bee76f8480'
            '0b8ea0be45a740071633ec6bc3b62b9d7bc4c9ce6ababa79fbfda70f614153ae')

prepare() {
  # Define REAL and VOID in triangle.h for programs using the library
  patch triangle.h < triangle_definitions.patch
}

build() {
  gcc $CFLAGS -std=gnu11 $LDFLAGS -o triangle triangle.c -lm
  gcc $CFLAGS -std=gnu11 -DTRILIBRARY -fPIC -c triangle.c
  gcc $CFLAGS -std=gnu11 $LDFLAGS -shared -o libtriangle.so triangle.o -lm
  gcc $CFLAGS -std=gnu11 $LDFLAGS -o showme showme.c -lX11
}

check() {
  gcc $CFLAGS -std=gnu11 -DANSI_DECLARATORS $LDFLAGS -o tricall tricall.c -L. -ltriangle
  LD_LIBRARY_PATH=. ./tricall
  ./triangle -pq A.poly
}

package_triangle() {
  pkgdesc='A Two-Dimensional Quality Mesh Generator and Delaunay Triangulator.'
  url="https://www.cs.cmu.edu/~quake/triangle.html"
  depends=('glibc')
  install -Dm755 triangle -t "$pkgdir"/usr/bin/
  install -Dm644 triangle.h -t "$pkgdir"/usr/include/
  install -Dm755 libtriangle.so -t "$pkgdir"/usr/lib/
  install -Dm644 README "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

package_showme() {
  pkgdesc='Show Me graphically displays the contents of geometric files, especially those generated by Triangle'
  url="https://www.cs.cmu.edu/~quake/showme.html"
  depends=('glibc'
           'libx11')
  install -Dm755 showme -t "$pkgdir"/usr/bin/
  install -Dm644 README "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
