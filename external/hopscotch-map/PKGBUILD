pkgname=hopscotch-map
pkgver=2.4.0
pkgrel=2
pkgdesc="C++ implementation of a fast hash map and hash set using hopscotch hashing"
arch=('any')
url="https://github.com/Tessil/$pkgname"
license=('MIT')
makedepends=('cmake')
checkdepends=('boost')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c147d1f6af9559c0e91af3ecf62274404ce5fb35ce94d2234c080ccc7a5913de')

build() {
  cd "$pkgname-$pkgver"
  cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None
  cmake --build build
  cmake -S tests -B build-tests -DCMAKE_BUILD_TYPE=None
  cmake --build build-tests
}

check() {
  cd "$pkgname-$pkgver"
  build-tests/tsl_hopscotch_map_tests
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
