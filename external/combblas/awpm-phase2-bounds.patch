                 IT idx1 = k;
                 IT idx2 = colptr[lcol];
                 
-                for(; std::get<0>(recvTuples[idx1]) == mi && idx2 < colptr[lcol+1];) //**
+                for(; idx1 < static_cast<IT>(recvTuples.size()) && std::get<0>(recvTuples[idx1]) == mi && idx2 < colptr[lcol+1];) //**
                 {
                     
                     IT mj = std::get<1>(recvTuples[idx1]) ;
@@ -627,7 +627,7 @@ std::vector< std::tuple<IT,IT,IT,NT> > Phase2(const AWPM_param<IT>& param, std::
                         idx2 ++;
                 }
                 
-                for(;std::get<0>(recvTuples[idx1]) == mi ; idx1++);
+                for(; idx1 < static_cast<IT>(recvTuples.size()) && std::get<0>(recvTuples[idx1]) == mi ; idx1++);
                 k = idx1;
              
         }
@@ -671,7 +671,7 @@ std::vector< std::tuple<IT,IT,IT,NT> > Phase2(const AWPM_param<IT>& param, std::
             IT idx1 = k;
             IT idx2 = colptr[lcol];
             
-            for(; std::get<0>(recvTuples[idx1]) == mi && idx2 < colptr[lcol+1];) //**
+            for(; idx1 < static_cast<IT>(recvTuples.size()) && std::get<0>(recvTuples[idx1]) == mi && idx2 < colptr[lcol+1];) //**
             {
                 
                 IT mj = std::get<1>(recvTuples[idx1]) ;
@@ -712,7 +712,7 @@ std::vector< std::tuple<IT,IT,IT,NT> > Phase2(const AWPM_param<IT>& param, std::
                     idx2 ++;
             }
             
-            for(;std::get<0>(recvTuples[idx1]) == mi ; idx1++);
