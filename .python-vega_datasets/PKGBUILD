_name=vega_datasets
pkgname=python-$_name
pkgver=0.9
pkgrel=2
pkgdesc="A Python package for offline access to Vega datasets"
arch=('any')
url="https://github.com/altair-viz/$_name"
license=('MIT')
depends=('python-pandas')
makedepends=('git'
             'python-build'
             'python-installer'
             'python-setuptools')
checkdepends=('python-pytest')
source=("$_name::git+$url.git#tag=v$pkgver")
sha256sums=('55cdc4e563cc158f34db896c8f2c3529f482de183ccf10e745f4245c5a5f7b46')

build() {
  cd "$srcdir"/$_name
  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    --doctest-modules
  )
  cd "$srcdir"/$_name
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest "${pytest_options[@]}" $_name
}

package() {
  cd "$srcdir"/$_name
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
