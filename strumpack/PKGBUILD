         'metis'
         'parmetis'
         'scotch'
         'zfp')
makedepends=('cmake'
             'gcc-fortran')
_mm='https://www.cise.ufl.edu/research/sparse/MM'
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "$_mm/Bai/rdb968.tar.gz"
