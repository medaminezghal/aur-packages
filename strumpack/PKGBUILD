prepare() {
  cd "$_name-$pkgver"
  # Don't index an empty vector in the distributed HSS extraction (trips _GLIBCXX_ASSERTIONS in SPARSE_mpi_24 and SPARSE_mpi_31)
  patch -Np1 -i ../hss-extract-empty-blocks.patch
  # Sort the entries that pad the sparsity pattern, so the ordering no longer depends on the thread timing (random SPARSE_seq_27 and SPARSE_seq_77 failures)
  patch -Np1 -i ../deterministic-symmetrize.patch
}

build() {
  cd "$_name-$pkgver"
  cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -DBUILD_SHARED_LIBS=ON -DSTRUMPACK_USE_MPI=ON -DSTRUMPACK_USE_OPENMP=ON -DTPL_ENABLE_PARMETIS=ON -DTPL_ENABLE_SCOTCH=ON -DTPL_ENABLE_PTSCOTCH=ON -DTPL_ENABLE_ZFP=ON -DTPL_ENABLE_SLATE=OFF -DTPL_ENABLE_BPACK=OFF -DTPL_SCALAPACK_LIBRARIES=/usr/lib/libscalapack.so -Wno-dev
  cmake --build build
}

check() {
  cd "$_name-$pkgver"
  ln -sf "$srcdir"/rdb968 "$srcdir"/cz10228 "$srcdir"/cavity16 "$srcdir"/bcsstk28 "$srcdir"/bcsstm08 "$srcdir"/gemat11 "$srcdir"/sherman4 "$srcdir"/t2dal "$srcdir"/mesh3e1 "$srcdir"/cbuckle "$srcdir"/utm300 build/test/
  SCOTCH_DETERMINISTIC=1 ctest --test-dir build --output-on-failure
}

package() {
  cd "$_name-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
