_name=STRUMPACK
pkgname=${_name,,}
pkgver=8.1.0
pkgrel=1
pkgdesc="STRUctured Matrix PACKage: sparse direct solver and preconditioner with hierarchical low-rank compression"
arch=('x86_64')
url="https://github.com/pghysels/$_name"
license=('BSD-3-Clause-LBNL')
