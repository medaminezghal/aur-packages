+    // GMRES is left preconditioned, so it stops on the preconditioned
+    // residual, which can be much smaller than the true residual when
+    // the preconditioner is a rough (compressed) approximation. Check
+    // the componentwise backward error and restart GMRES from the
+    // current solution while it is too large and still decreasing.
+    auto gmres_verified =
+      [&](const std::function<void(scalar_t*)>& prec, bool prec_is_MF) {
+        gmres(prec);
+        int totit = this->Krylov_its_;
+        auto bw = mat_mpi_->max_scaled_residual(x.data(), bloc.data());
+        while (bw > opts_.rel_tol() && totit < opts_.maxit()) {
+          if (opts_.verbose() && is_root_)
+            std::cout << "# GMRES restart from current solution,"
+                      << " componentwise backward error = " << bw
+                      << std::endl;
+          std::vector<scalar_t> x_prev(x.data(), x.data()+nloc);
+          int its = 0;
+          iterative::GMResMPI<scalar_t>
+            (comm_, spmv, prec, nloc, x.data(), bloc.data(),
+             opts_.rel_tol(), opts_.abs_tol(), its,
+             opts_.maxit() - totit, opts_.gmres_restart(),
+             opts_.GramSchmidt_type(), true,
+             opts_.verbose() && is_root_);
+          totit += its;
+          auto bw_new = mat_mpi_->max_scaled_residual(x.data(), bloc.data());
+          if (!(bw_new < bw)) {
+            // no improvement, keep the previous solution
+            std::copy(x_prev.begin(), x_prev.end(), x.data());
+            break;
+          }
+          if (!(bw_new < bw / 2)) break;
+          bw = bw_new;
+        }
+        if (bw > opts_.rel_tol() && totit < opts_.maxit() &&
+            prec_is_MF) {
+          // GMRES stagnated, the preconditioner limits the accuracy of
+          // the preconditioned residual: continue with iterative
+          // refinement, which works with the true residual
+          if (opts_.verbose() && is_root_)
+            std::cout << "# GMRES stagnated, continue with iterative"
+                      << " refinement, componentwise backward error = "
+                      << bw << std::endl;
+          std::vector<scalar_t> x_prev(x.data(), x.data()+nloc);
+          int its = 0;
+          iterative::IterativeRefinementMPI<scalar_t,integer_t>
+            (comm_, *mat_mpi_,
+             [&](DenseM_t& w) {
+               tree()->multifrontal_solve_dist(w, mat_mpi_->dist()); },
+             x, bloc, opts_.rel_tol(), opts_.abs_tol(),
+             its, opts_.maxit() - totit, true,
+             opts_.verbose() && is_root_);
+          totit += its;
+          auto bw_new = mat_mpi_->max_scaled_residual(x.data(), bloc.data());
+          if (!(bw_new < bw))
+            std::copy(x_prev.begin(), x_prev.end(), x.data());
+        }
+        this->Krylov_its_ = totit;
+      };
