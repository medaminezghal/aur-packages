_name=zstd
pkgname=python-$_name
pkgver=1.5.7.3
pkgrel=1
pkgdesc="ZSTD Bindings for Python"
arch=('x86_64' 'aarch64' 'i686' 'arm' 'armv6h' 'armv7h')
url="https://github.com/sergey-dryabzhinsky/python-zstd"
license=('BSD-2-Clause')
depends=('python'
         'glibc'
         'zstd')
makedepends=('python-build'
             'python-installer'
             'python-setuptools')
checkdepends=('python-pytest')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz")
sha256sums=('403e5205f4ac04b92e6b0cda654be2f51de268228a0db0067bc087faacf2f495')

build() {
  cd "$srcdir"/$_name-$pkgver
  ZSTD_EXTERNAL=1 python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
  )
  cd "$srcdir"/$_name-$pkgver
  PYTHONPATH="$(realpath build/lib.linux-*)" python -m pytest "${pytest_options[@]}"
}

package() {
  cd "$srcdir"/$_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
